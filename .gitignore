# Environment & API keys (STRICT - NEVER COMMIT SECRETS)
.env
*.env
.env.*
**/.env
**/*.env
!.env.example
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.deepeval/
**/.deepeval/
venv/
.venv/

# Node & Remotion & HyperFrames
node_modules/
**/node_modules/
out/
**/out/
dist/
**/dist/
build/
**/build/
.remotion/
**/.remotion/
.hyperframes/
**/.hyperframes/
.cache/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Heavy Renders & Temporary Intermediate Media (>50MB)
*.blend1
*.blend2
*.zip
*.tar.gz
*.part
*.tmp
*.temp
**/assets/music/*.wav
**/soundtrack_bed.wav

# Ignore raw download scrapes and intermediate render scratchpads
downloads/
**/downloads/
**/dialogue_raw/
projects/**/remotion/renders/
production/exports/*.mp4
projects/**/final/*.mp4

# General binary video ignores (keep repos lean)
*.mp4
*.mov
*.avi
*.mkv

# Whitelist documentation demo media
!docs/assets/*.mp4
!**/docs/assets/*.mp4
!docs/assets/*.gif
!**/docs/assets/*.gif
!docs/assets/*.png
!**/docs/assets/*.png
!docs/assets/*.jpg
!**/docs/assets/*.jpg

# OS / Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
