{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CinematicPromptDirectorShot",
  "type": "object",
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "ESTABLISHING",
        "WIDE_REENACTMENT",
        "MEDIUM_REENACTMENT",
        "CLOSE_UP",
        "MACRO_DETAIL",
        "OVER_SHOULDER",
        "POV",
        "TECHNICAL",
        "DATA_VISUALIZATION",
        "DOCUMENT_EVIDENCE",
        "ABSTRACT_CONCEPT",
        "AERIAL",
        "TRANSITION"
      ]
    },
    "narration": {
      "type": "string"
    },
    "visual": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "composition": {
          "type": "string"
        },
        "foreground": {
          "type": "string"
        },
        "midground": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "atmosphere": {
          "type": "string"
        },
        "color_palette": {
          "type": "string"
        }
      },
      "required": [
        "subject",
        "action",
        "environment",
        "time",
        "context",
        "composition",
        "foreground",
        "midground",
        "background",
        "lighting",
        "materials",
        "atmosphere",
        "color_palette"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "shot_size": {
          "type": "string"
        },
        "camera_position": {
          "type": "string"
        },
        "camera_height": {
          "type": "string"
        },
        "angle": {
          "type": "string"
        },
        "lens": {
          "type": "string"
        },
        "depth_of_field": {
          "type": "string"
        },
        "movement": {
          "type": "string"
        }
      },
      "required": [
        "shot_size",
        "camera_position",
        "camera_height",
        "angle",
        "lens",
        "depth_of_field",
        "movement"
      ]
    },
    "continuity": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "characters",
        "locations",
        "objects",
        "reference_images"
      ]
    },
    "gemini_image_prompt": {
      "type": "string"
    },
    "negative_prompt": {
      "type": "string"
    },
    "image_to_video_prompt": {
      "type": "string"
    },
    "quality_targets": {
      "type": "object",
      "properties": {
        "story_alignment": {
          "type": "number"
        },
        "composition": {
          "type": "number"
        },
        "photorealism": {
          "type": "number"
        },
        "cinematography": {
          "type": "number"
        },
        "character_consistency": {
          "type": "number"
        },
        "environment_consistency": {
          "type": "number"
        },
        "technical_accuracy": {
          "type": "number"
        },
        "lighting": {
          "type": "number"
        },
        "visual_clarity": {
          "type": "number"
        },
        "video_motion_potential": {
          "type": "number"
        }
      },
      "required": [
        "story_alignment",
        "composition",
        "photorealism",
        "cinematography",
        "character_consistency",
        "environment_consistency",
        "technical_accuracy",
        "lighting",
        "visual_clarity",
        "video_motion_potential"
      ]
    }
  },
  "required": [
    "shot_id",
    "purpose",
    "shot_type",
    "narration",
    "visual",
    "camera",
    "continuity",
    "gemini_image_prompt",
    "negative_prompt",
    "image_to_video_prompt",
    "quality_targets"
  ]
}