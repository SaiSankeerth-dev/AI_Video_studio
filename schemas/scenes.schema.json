{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentaryScenesSchema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "scene_id", "chapter_id", "title", "purpose", "duration_seconds",
      "start", "end", "emotional_state", "shots"
    ],
    "properties": {
      "scene_id": { "type": "string" },
      "chapter_id": { "type": "string" },
      "title": { "type": "string" },
      "purpose": { "type": "string" },
      "duration_seconds": { "type": "number" },
      "start": { "type": "number" },
      "end": { "type": "number" },
      "emotional_state": { "type": "string" },
      "shots": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
