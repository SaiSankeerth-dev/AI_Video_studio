{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimelineSchema",
  "type": "object",
  "required": ["project_id", "fps", "resolution", "total_frames", "total_seconds", "tracks"],
  "properties": {
    "project_id": { "type": "string" },
    "fps": { "type": "integer" },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "total_frames": { "type": "integer" },
    "total_seconds": { "type": "number" },
    "tracks": {
      "type": "object",
      "required": ["video", "audio"],
      "properties": {
        "video": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shot_id", "start_frame", "end_frame", "duration_frames", "asset_path"],
            "properties": {
              "shot_id": { "type": "string" },
              "start_frame": { "type": "integer" },
              "end_frame": { "type": "integer" },
              "duration_frames": { "type": "integer" },
              "asset_path": { "type": "string" },
              "camera_motion": { "type": "string" },
              "transition": { "type": "string" }
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["track_name", "clips"],
            "properties": {
              "track_name": { "type": "string" },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["clip_id", "start_time", "duration", "file"],
                  "properties": {
                    "clip_id": { "type": "string" },
                    "start_time": { "type": "number" },
                    "duration": { "type": "number" },
                    "file": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
